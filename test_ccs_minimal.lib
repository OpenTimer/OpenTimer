library (tcbn07_bwph240l11p57pd_base_svttt_0p65v_25c_typical_ccs) {
    /*  library head: tcbn07_bwph240l11p57pd_base_svt */
    technology (cmos) ;
    delay_model : table_lookup ;
    date                : "Thu Mar 19 17:52:00 2020 " ;
    comment : "Copyright TSMC" ;
    revision    : 130 ;
    simulation  : true ;
    nom_process : 1 ; /* TTMacro_MOS_MOSCAP */
    nom_temperature : 25;
    nom_voltage : 0.65;
    voltage_map(VDD, 0.65);
    voltage_map(VBB, 0);
    voltage_map(VPP, 0.65);
    voltage_map(VSS, 0);
    operating_conditions("tt_0p65v_25c_typical"){
        process : 1; /* TTMacro_MOS_MOSCAP */
        temperature : 25;
        voltage : 0.65;
        tree_type : "balanced_tree";
    }
    default_operating_conditions : tt_0p65v_25c_typical ;
    capacitive_load_unit (1,pf) ;
    voltage_unit : "1V" ;
    current_unit : "1mA" ;
    time_unit : "1ns" ;
    pulling_resistance_unit : "1kohm"; 
    define_cell_area (pad_drivers,pad_driver_sites) ;
    define_cell_area(bond_pads,pad_slots) ;
    library_features (report_delay_calculation,report_power_calculation);
    default_leakage_power_density : 0.0;
    default_fanout_load : 1;

wire_load("ZeroWireload") {
resistance : 0.00001 ;
capacitance : 1 ;
area : 0
slope : 0 ;
fanout_length(1,0.0000)
fanout_length(2,0.0000)
fanout_length(3,0.0000)
fanout_length(4,0.0000)
fanout_length(5,0.0000)
fanout_length(6,0.0000)
fanout_length(7,0.0000)
