#
# Bazel build of the masc-ucsc fork, consumed by LiveHD as
# local_repository(name = "opentimer", path = "../OpenTimer"), and as a
# standalone Bzlmod project. The CMake build (CMakeLists.txt) is unaffected.

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "opentimer",
    srcs = glob(["ot/**/*.cpp"]),
    hdrs = glob(
        ["ot/**/*.hpp"],
        exclude = [
            "ot/config.hpp",  # CMake-generated, potentially containing host paths.
            "ot/taskflow/**/*.hpp",
        ],
    ),
    copts = [
        "-w",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":taskflow",
        "//packages:config",
    ],
)

# OpenTimer bundles its own (forked 4.0) taskflow under ot/taskflow, compiled
# into every OT object. Anything living in the same binary as OpenTimer MUST
# use THIS taskflow copy: linking a second taskflow version alongside is an
# ODR violation — two different tf::Executor/tf::Worker layouts behind one set
# of weak inline symbols — that corrupts the executor at runtime (EXC_BAD_ACCESS
# inside tf::Worker lookups the first time both run in one process). The
# `includes = ["ot"]` entry maps the canonical #include "taskflow/taskflow.hpp"
# onto the bundled ot/taskflow headers, so consumers need no source changes.
cc_library(
    name = "taskflow",
    hdrs = glob(["ot/taskflow/**/*.hpp"]),
    includes = ["ot"],
    linkopts = ["-pthread"],
    visibility = ["//visibility:public"],
)

# Every library source, for consumers that hash the timing engine into a cache
# salt (pass/opentimer in LiveHD).
filegroup(
    name = "srcs",
    srcs = glob(
        [
            "ot/**/*.cpp",
            "ot/**/*.hpp",
        ],
        exclude = ["ot/config.hpp"],
    ) + ["//packages:ot/config.hpp"],
    visibility = ["//visibility:public"],
)
